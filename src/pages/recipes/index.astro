---
import Layout from "@/layouts/Layout.astro";
import RecipeListAside from "@/components/recipe/RecipeListAside.astro";
import { Button } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { listRecipes } from "@/lib/recipe-queries";
import type { RecipeListItem } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

type PageState = "error" | "empty" | "list";
let pageState: PageState = "error";
let items: RecipeListItem[] = [];

if (supabase && user) {
  const result = await listRecipes(supabase, user.id);
  if (result.ok) {
    pageState = result.items.length === 0 ? "empty" : "list";
    items = result.items;
  }
}
---

<Layout title="Twoje przepisy">
  <div class="flex min-h-0 flex-1">
    <RecipeListAside state={pageState} items={items} />

    <div class="hidden flex-1 items-center justify-center p-8 lg:flex">
      {
        pageState === "error" && (
          <div class="border-err/30 bg-err/5 max-w-md rounded-md border p-6 text-center" role="alert">
            <p class="text-ink font-medium">Nie udało się wczytać przepisów</p>
            <p class="text-ink-3 mt-2 text-sm">
              Sprawdź połączenie z bazą danych lub skonfiguruj Supabase, a następnie odśwież stronę.
            </p>
          </div>
        )
      }

      {
        pageState === "empty" && (
          <div class="border-rule shadow-card max-w-md rounded-md border bg-white p-8 text-center">
            <p class="text-ink-3 text-sm">Nie masz jeszcze przepisów.</p>
            <Button asChild variant="copper" className="mt-4">
              <a href="/recipes/new">Nowy przepis</a>
            </Button>
          </div>
        )
      }

      {
        pageState === "list" && (
          <div class="max-w-md text-center">
            <p class="text-ink-3 text-sm">Wybierz przepis z listy albo utwórz nowy.</p>
            <Button asChild variant="copper" className="mt-4">
              <a href="/recipes/new">Nowy przepis</a>
            </Button>
          </div>
        )
      }
    </div>
  </div>
</Layout>
