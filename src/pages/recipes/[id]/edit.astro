---
import Layout from "@/layouts/Layout.astro";
import RecipeWizard from "@/components/recipe/RecipeWizard";
import { Button } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { getRecipe } from "@/lib/recipe-queries";

export const prerender = false;

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const id = Astro.params.id;

const record = supabase && user && id ? await getRecipe(supabase, user.id, id) : null;

if (!record) {
  Astro.response.status = 404;
}
---

{
  !record ? (
    <Layout title="Nie znaleziono przepisu">
      <div class="flex flex-1 items-center justify-center p-4">
        <div class="border-rule shadow-card max-w-md rounded-md border bg-white p-8 text-center">
          <h1 class="text-ink font-serif text-3xl font-medium tracking-[-0.02em]">Nie znaleziono przepisu</h1>
          <p class="text-ink-3 mt-3 text-sm">Przepis nie istnieje lub nie masz do niego dostępu.</p>
          <Button asChild variant="outline" className="mt-6">
            <a href="/recipes">Wróć do listy</a>
          </Button>
        </div>
      </div>
    </Layout>
  ) : (
    <Layout title={`Edytuj: ${record.name}`} shell="bare">
      <RecipeWizard client:load recipeId={id} initialData={record.data} />
    </Layout>
  )
}
