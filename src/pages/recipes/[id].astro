---
import Layout from "@/layouts/Layout.astro";
import RecipeListAside from "@/components/recipe/RecipeListAside.astro";
import RecipeMetricTiles from "@/components/recipe/RecipeMetricTiles.astro";
import RecipeExportActions from "@/components/recipe/RecipeExportActions";
import { DeleteRecipeDialog } from "@/components/recipe/DeleteRecipeDialog";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import { ColorSwatch } from "@/components/ui/color-swatch";
import { SectionTitle } from "@/components/ui/section-title";
import { StatTile } from "@/components/ui/stat-tile";
import { createClient } from "@/lib/supabase";
import { getRecipe, listRecipes } from "@/lib/recipe-queries";
import { ADJUNCT_STAGE_LABELS, HOP_STAGE_LABELS } from "@/lib/recipe-labels";
import type { RecipeListItem, RecipeRecord } from "@/types";

export const prerender = false;

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const id = Astro.params.id;

let record: RecipeRecord | null = null;
let listItems: RecipeListItem[] = [];
let listState: "error" | "empty" | "list" = "error";

if (supabase && user && id) {
  const [recordResult, listResult] = await Promise.all([
    getRecipe(supabase, user.id, id),
    listRecipes(supabase, user.id),
  ]);
  record = recordResult;
  if (listResult.ok) {
    listItems = listResult.items;
    listState = listItems.length === 0 ? "empty" : "list";
  }
}

if (!record) {
  Astro.response.status = 404;
}

const { data } = record ?? { data: null };

const dateFormatter = new Intl.DateTimeFormat("pl-PL", { dateStyle: "medium", timeStyle: "short" });

const ANCHORS = [
  { href: "#przeglad", label: "Przegląd" },
  { href: "#zasyp", label: "Zasyp" },
  { href: "#zacieranie", label: "Zacieranie" },
  { href: "#chmiel", label: "Chmiel" },
  { href: "#drozdze", label: "Drożdże" },
  { href: "#dodatki", label: "Dodatki" },
] as const;

const totalMaltKg = data ? data.malts.reduce((sum, malt) => sum + malt.amountKg, 0) : 0;

const cardClass = "border-rule rounded-md border bg-white p-6";
const sectionTableHeadClass = "border-rule border-b font-mono text-[10px] tracking-[0.08em] text-ink-3 uppercase";
const sectionTableCellClass = "border-rule-soft border-b border-dashed py-2.5 text-sm";
---

{
  !record || !data ? (
    <Layout title="Nie znaleziono przepisu">
      <div class="flex flex-1 items-center justify-center p-4">
        <div class="border-rule shadow-card max-w-md rounded-md border bg-white p-8 text-center">
          <h1 class="text-ink font-serif text-3xl font-medium tracking-[-0.02em]">Nie znaleziono przepisu</h1>
          <p class="text-ink-3 mt-3 text-sm">Przepis nie istnieje lub nie masz do niego dostępu.</p>
          <Button asChild variant="outline" className="mt-6">
            <a href="/recipes">Wróć do listy</a>
          </Button>
        </div>
      </div>
    </Layout>
  ) : (
    <Layout title={record.name}>
      <div class="flex min-h-0 flex-1">
        <RecipeListAside class="hidden lg:flex" state={listState} items={listItems} activeId={id} titleAs="h2" />

        <div class="min-w-0 flex-1">
          <div class="px-4 pt-4 lg:hidden">
            <a href="/recipes" class="text-ink-3 hover:text-ink text-sm transition-colors">
              ← Wszystkie przepisy
            </a>
          </div>

          <header class="border-rule bg-paper-2 border-b px-4 py-6 sm:px-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <Badge tone="copper">{record.style}</Badge>
                </div>
                <h1 class="text-ink font-serif text-[clamp(28px,5vw,44px)] font-medium tracking-[-0.03em]">
                  {record.name}
                </h1>
                <p class="text-ink-3 mt-2 font-mono text-xs">
                  Ostatnio edytowano: {dateFormatter.format(new Date(record.updatedAt))}
                </p>
              </div>
              <div class="flex flex-wrap items-start gap-2">
                <RecipeExportActions record={record} client:load />
                <a href={`/recipes/${id}/edit`} class:list={[buttonVariants({ variant: "copper", size: "sm" })]}>
                  Edytuj
                </a>
                <DeleteRecipeDialog recipeId={id ?? ""} recipeName={record.name} client:load />
              </div>
            </div>

            <div class="mt-5 flex flex-wrap items-stretch gap-3">
              <div class="min-w-[240px] flex-1">
                <RecipeMetricTiles metrics={record} />
              </div>
              <div class="flex items-stretch gap-3">
                <StatTile label="Objętość" value={data.batch.volumeL} unit="L" />
                <div class="border-rule-soft bg-paper-3 flex items-center justify-center rounded-md border px-5">
                  <ColorSwatch srm={record.srm} size="lg" />
                </div>
              </div>
            </div>
          </header>

          <nav
            aria-label="Sekcje przepisu"
            class="border-rule bg-paper sticky top-0 z-10 flex gap-4 overflow-x-auto border-b px-4 py-2.5 sm:px-8"
          >
            {ANCHORS.map((anchor) => (
              <a
                href={anchor.href}
                class="text-ink-2 hover:text-ink hover:border-copper focus-visible:border-copper shrink-0 border-b-2 border-transparent pb-1 font-mono text-xs tracking-[0.03em] uppercase transition-colors"
              >
                {anchor.label}
              </a>
            ))}
          </nav>

          <div class="flex flex-col gap-6 px-4 py-6 sm:px-8">
            <section id="przeglad" class:list={cardClass + " scroll-mt-14"}>
              <SectionTitle eyebrow="Przegląd" title="Podstawy" as="h2" />
              <dl class="grid gap-4 sm:grid-cols-2">
                <div>
                  <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Styl</dt>
                  <dd class="mt-1 text-sm">{data.basics.style}</dd>
                </div>
                <div>
                  <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Objętość</dt>
                  <dd class="mt-1 text-sm tabular-nums">{data.batch.volumeL} L</dd>
                </div>
              </dl>
            </section>

            <section id="zasyp" class:list={cardClass + " scroll-mt-14"}>
              <SectionTitle eyebrow="Zasyp" title={`${totalMaltKg.toFixed(2)} kg`} as="h2" />
              {data.malts.length === 0 ? (
                <p class="text-ink-3 text-sm">brak</p>
              ) : (
                <div class="overflow-x-auto">
                  <table class="w-full min-w-[480px] border-collapse">
                    <thead>
                      <tr>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-left"}>
                          Nazwa
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-right"}>
                          Ilość
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-right"}>
                          %
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-right"}>
                          EBC
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-right"}>
                          Ekstrakt
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.malts.map((malt) => (
                        <tr>
                          <td class:list={sectionTableCellClass + " font-medium"}>{malt.name}</td>
                          <td class:list={sectionTableCellClass + " text-right font-mono tabular-nums"}>
                            {malt.amountKg.toFixed(2)} kg
                          </td>
                          <td class:list={sectionTableCellClass + " text-ink-3 text-right font-mono tabular-nums"}>
                            {totalMaltKg > 0 ? ((malt.amountKg / totalMaltKg) * 100).toFixed(1) : "0.0"}%
                          </td>
                          <td class:list={sectionTableCellClass + " text-right font-mono tabular-nums"}>
                            {malt.colorEbc}
                          </td>
                          <td class:list={sectionTableCellClass + " text-right font-mono tabular-nums"}>
                            {malt.extractPercent}%
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </section>

            <section id="zacieranie" class:list={cardClass + " scroll-mt-14"}>
              <SectionTitle eyebrow="Zacieranie" title={`${data.mash.rests.length} przerw`} as="h2" />
              <dl class="grid gap-4 sm:grid-cols-2">
                <div>
                  <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Wydajność</dt>
                  <dd class="mt-1 text-sm tabular-nums">{data.mash.efficiencyPct}%</dd>
                </div>
                <div>
                  <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Stosunek wody do zboża</dt>
                  <dd class="mt-1 text-sm tabular-nums">{data.mash.waterToGrainRatio} L/kg</dd>
                </div>
              </dl>
              {data.mash.rests.length === 0 ? (
                <p class="text-ink-3 mt-4 text-sm">brak</p>
              ) : (
                <ul class="mt-4 flex flex-col gap-2">
                  {data.mash.rests.map((rest, index) => (
                    <li class="border-rule-soft border-b border-dashed py-2 text-sm">
                      Przerwa {index + 1} · <span class="tabular-nums">{rest.tempC}°C</span> ·{" "}
                      <span class="tabular-nums">{rest.durationMin} min</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            <section id="chmiel" class:list={cardClass + " scroll-mt-14"}>
              <SectionTitle
                eyebrow="Chmiel"
                title={`${data.hops.length} ${data.hops.length === 1 ? "chmiel" : "chmiele"}`}
                as="h2"
              />
              {data.hops.length === 0 ? (
                <p class="text-ink-3 text-sm">brak</p>
              ) : (
                <div class="overflow-x-auto">
                  <table class="w-full min-w-[480px] border-collapse">
                    <thead>
                      <tr>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-left"}>
                          Nazwa
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-right"}>
                          Alfa
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-right"}>
                          Ilość
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-left"}>
                          Etap
                        </th>
                        <th scope="col" class:list={sectionTableHeadClass + " py-2 text-right"}>
                          Czas
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.hops.map((hop) => (
                        <tr>
                          <td class:list={sectionTableCellClass + " font-medium"}>{hop.name}</td>
                          <td class:list={sectionTableCellClass + " text-right font-mono tabular-nums"}>
                            {hop.alphaAcidPercent}%
                          </td>
                          <td class:list={sectionTableCellClass + " text-right font-mono tabular-nums"}>
                            {hop.amountG} g
                          </td>
                          <td class:list={sectionTableCellClass}>
                            <Badge tone={hop.stage === "dryHop" ? "hop" : "neutral"}>
                              {HOP_STAGE_LABELS[hop.stage]}
                            </Badge>
                          </td>
                          <td class:list={sectionTableCellClass + " text-right font-mono tabular-nums"}>
                            {hop.timeMin} min
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </section>

            <section id="drozdze" class:list={cardClass + " scroll-mt-14"}>
              <SectionTitle eyebrow="Drożdże" title={data.yeast.strain || "—"} as="h2" />
              <dl class="grid gap-4 sm:grid-cols-2">
                <div>
                  <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Typ</dt>
                  <dd class="mt-1 text-sm">{data.yeast.type || "—"}</dd>
                </div>
                <div>
                  <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Atenuacja</dt>
                  <dd class="mt-1 text-sm tabular-nums">{data.yeast.attenuationPct}%</dd>
                </div>
                <div>
                  <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Temp. fermentacji</dt>
                  <dd class="mt-1 text-sm tabular-nums">
                    {data.yeast.fermTempMinC}–{data.yeast.fermTempMaxC}°C
                  </dd>
                </div>
              </dl>
            </section>

            <section id="dodatki" class:list={cardClass + " scroll-mt-14"}>
              <SectionTitle
                eyebrow="Dodatki"
                title={`${data.adjuncts.length} ${data.adjuncts.length === 1 ? "dodatek" : "dodatków"}`}
                as="h2"
              />
              {data.adjuncts.length === 0 ? (
                <p class="text-ink-3 text-sm">brak</p>
              ) : (
                <ul class="flex flex-col gap-3">
                  {data.adjuncts.map((adjunct) => (
                    <li class="border-rule-soft border-b border-dashed pb-3">
                      <p class="text-sm font-medium">{adjunct.name || "—"}</p>
                      <dl class="mt-2 grid gap-2 text-sm sm:grid-cols-2">
                        <div>
                          <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Etap</dt>
                          <dd class="mt-1">{ADJUNCT_STAGE_LABELS[adjunct.stage]}</dd>
                        </div>
                        <div>
                          <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Czas</dt>
                          <dd class="mt-1 tabular-nums">{adjunct.timeMin} min</dd>
                        </div>
                        {adjunct.notes && (
                          <div class="sm:col-span-2">
                            <dt class="text-ink-3 font-mono text-[10px] tracking-[0.08em] uppercase">Notatki</dt>
                            <dd class="mt-1">{adjunct.notes}</dd>
                          </div>
                        )}
                      </dl>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </div>
        </div>
      </div>
    </Layout>
  )
}
