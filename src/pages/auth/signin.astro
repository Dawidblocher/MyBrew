---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zaloguj się" shell="bare">
  <AuthCard title="Zaloguj się">
    <SignInForm serverError={error} client:load />
    <p slot="footer" class="text-ink-3 text-center text-[13px]">
      Nie masz konta?
      <a href="/auth/signup" class="text-copper rounded-sm font-medium underline-offset-4 hover:underline">
        Zarejestruj się
      </a>
    </p>
  </AuthCard>
</Layout>
