---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zarejestruj się" shell="bare">
  <AuthCard title="Zarejestruj się">
    <SignUpForm serverError={error} client:load />
    <p slot="footer" class="text-ink-3 text-center text-[13px]">
      Masz już konto?
      <a href="/auth/signin" class="text-copper rounded-sm font-medium underline-offset-4 hover:underline">
        Zaloguj się
      </a>
    </p>
  </AuthCard>
</Layout>
