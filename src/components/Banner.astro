---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-align: center;
    border-bottom: 1px solid;
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  .banner--info {
    background: var(--paper-2);
    color: var(--ink);
    border-color: var(--rule);
  }
  .banner--warning {
    background: color-mix(in srgb, var(--warn) 12%, var(--paper));
    color: var(--ink);
    border-color: var(--warn);
  }
  .banner--error {
    background: color-mix(in srgb, var(--err) 10%, var(--paper));
    color: var(--err);
    border-color: var(--err);
  }
</style>
