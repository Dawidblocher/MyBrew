---
import { ChartLine, FileText, Layers } from "lucide-react";

import { Button } from "@/components/ui/button";
import { Eyebrow } from "@/components/ui/eyebrow";

const { user } = Astro.locals;

const ctas = user
  ? {
      primary: { label: "Twoje przepisy", href: "/recipes" },
      secondary: { label: "Nowy przepis", href: "/recipes/new" },
    }
  : {
      primary: { label: "Zacznij za darmo", href: "/auth/signup" },
      secondary: { label: "Zaloguj się", href: "/auth/signin" },
    };

const metrics = ["BLG", "ABV", "SRM", "IBU"] as const;

const features = [
  {
    Icon: ChartLine,
    title: "Obliczenia na żywo",
    description:
      "BLG, ABV, SRM i IBU aktualizują się automatycznie w trakcie tworzenia przepisu — widzisz wynik od razu, zanim zapiszesz.",
  },
  {
    Icon: Layers,
    title: "Pełny kreator krok po kroku",
    description:
      "Podstawy → zasyp → zacieranie → chmiel → drożdże → dodatki. Każdy etap w jednym przewodniku, bez przeskakiwania między narzędziami.",
  },
  {
    Icon: FileText,
    title: "Zapis i przegląd przepisów",
    description:
      "Zapisuj gotowe przepisy na swoim koncie i wracaj do listy z kluczowymi parametrami — wszystko w jednym miejscu.",
  },
] as const;
---

<div class="w-full px-4 sm:px-8">
  <section class="mx-auto flex max-w-4xl flex-col items-start py-16 sm:py-24 lg:py-28">
    <Eyebrow className="mb-4">Kreator przepisów piwnych</Eyebrow>
    <h1 class="text-ink mb-6 font-serif text-5xl leading-[1.05] font-medium tracking-[-0.03em] sm:text-6xl lg:text-7xl">
      Beer Recipe Builder
    </h1>
    <p class="text-ink-2 mb-8 max-w-2xl text-base leading-relaxed sm:text-lg">
      Kreator przepisów piwnych krok po kroku z obliczeniami BLG, ABV, SRM i IBU na żywo — bez arkuszy i zewnętrznych
      kalkulatorów.
    </p>

    <ul class="mb-10 flex flex-wrap gap-2" aria-label="Wyliczane parametry">
      {
        metrics.map((metric) => (
          <li class="border-rule bg-chip text-chip-ink inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 font-mono text-[11px] tracking-[0.08em] uppercase">
            <span class="text-copper font-medium">{metric}</span>
            <span aria-hidden="true">·</span>
            <span>na żywo</span>
          </li>
        ))
      }
    </ul>

    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <Button asChild variant="copper" className="h-11 px-6 text-sm">
        <a href={ctas.primary.href}>{ctas.primary.label}</a>
      </Button>
      <Button asChild variant="outline" className="h-11 px-6 text-sm">
        <a href={ctas.secondary.href}>{ctas.secondary.label}</a>
      </Button>
    </div>
  </section>

  <section class="border-rule mx-auto max-w-4xl border-t pt-10 pb-20" aria-labelledby="features-heading">
    <h2 id="features-heading" class="sr-only">Możliwości</h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        features.map(({ Icon, title, description }) => (
          <li class="border-rule shadow-card rounded-md border bg-white p-5">
            <Icon className="text-copper mb-4 size-6" aria-hidden="true" />
            <h3 class="text-ink mb-2 font-serif text-lg font-medium tracking-[-0.01em]">{title}</h3>
            <p class="text-ink-2 text-[13px] leading-relaxed">{description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</div>
