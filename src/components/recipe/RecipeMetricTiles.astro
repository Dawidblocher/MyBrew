---
import { StatTile } from "@/components/ui/stat-tile";
import { formatMetricValue, METRIC_DESCRIPTORS, METRIC_PLACEHOLDER } from "@/lib/recipe-metrics";
import type { RecipeMetricsSnapshot } from "@/types";

interface Props {
  metrics: RecipeMetricsSnapshot;
  compact?: boolean;
}

const { metrics, compact = false } = Astro.props;
---

<section class:list={["grid grid-cols-2 gap-3 sm:grid-cols-4", compact && "gap-2"]} aria-label="Wyliczenia przepisu">
  {
    METRIC_DESCRIPTORS.map(({ key, label, unit, fractionDigits }) => {
      const value = formatMetricValue(metrics[key], fractionDigits);
      return <StatTile label={label} value={value} unit={unit} placeholder={value === METRIC_PLACEHOLDER} />;
    })
  }
</section>
