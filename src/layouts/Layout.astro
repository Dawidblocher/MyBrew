---
import "../styles/global.css";
import { Font } from "astro:assets";
import AppRail from "@/components/AppRail.astro";
import AppTopBar from "@/components/AppTopBar.astro";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** `app` renders the navigation shell; `bare` renders only the page (wizard, auth). */
  shell?: "app" | "bare";
}

const { title = "Beer Recipe Builder", shell = "app" } = Astro.props;
const { user } = Astro.locals;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <Font cssVariable="--font-plex-sans" preload={[{ weight: 400, subset: "latin" }]} />
    <Font cssVariable="--font-fraunces" />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body class="bg-background text-foreground min-h-dvh">
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    {
      shell === "app" ? (
        <div class:list={["min-h-dvh", user && "lg:grid lg:grid-cols-[64px_1fr]"]}>
          {user && <AppRail />}
          <div class="flex min-h-dvh min-w-0 flex-col">
            <AppTopBar />
            <main class="flex flex-1 flex-col">
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <main class="flex min-h-dvh flex-col">
          <slot />
        </main>
      )
    }
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
